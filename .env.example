# =============================================================================
# Espada3D Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.

# =============================================================================
# Client — React App (REACT_APP_ prefix required by Create React App)
# =============================================================================

# Firebase configuration (from Firebase Console → Project Settings)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# WebSocket URL for the collaboration server
REACT_APP_COLLAB_WS_URL=ws://localhost:1234

# =============================================================================
# Server — Collab Server (server/collab-server.js)
# =============================================================================

# Port the WebSocket collaboration server listens on
PORT=1234

# Firebase project ID for server-side auth verification
FIREBASE_PROJECT_ID=

# Path to the Firebase service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=

# Whether to require Firebase authentication for WebSocket connections (true/false)
REQUIRE_AUTH=true

# Allowed CORS origins (comma-separated, or * for all)
CORS_ORIGINS=*

# Rate limiting: time window in milliseconds
RATE_LIMIT_WINDOW_MS=60000

# Rate limiting: max connections per window
RATE_LIMIT_MAX=30

# =============================================================================
# TLS (optional) — provide both to enable wss:// on the collab server
# =============================================================================

# Path to the TLS certificate file
TLS_CERT_PATH=

# Path to the TLS private key file
TLS_KEY_PATH=
